{
  "name": "kohlab",
  "version": "1.15.0",
  "description": "Run your AI coding agents in parallel, persistently, from any device.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kohlab": "cli.ts"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "node-pty": "^1.0.0"
  },
  "scripts": {
    "start": "bun run server.ts",
    "cli": "bun run cli.ts",
    "dev": "bun run --watch server.ts",
